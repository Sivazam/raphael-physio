# ─────────────────────────────────────────────────────────────
# Raphael Physiotherapy & Rehabilitation Centre — environment
# Copy to `.env` and fill in real values before deploying.
# Never commit the real `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Database (SQLite; path is relative to the project root)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Admin CMS seed — applied by `bun prisma/seed.ts` (upserted, never destructive)
ADMIN_EMAIL=admin@raphaelphysio.local
ADMIN_PASSWORD=change-me-before-launch
ADMIN_NAME=Clinic Administrator
# Long random string used to sign admin session cookies (scrypt + HMAC)
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Public site URL (used for canonical URLs / sitemap / robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google reviews (OPTIONAL — leave unset until the clinic authorizes) ──
# When unset, /reviews shows an honest "connect us on Google" state.
# Uses Google Places (New) API.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# How often the background sync refreshes cached reviews (hours)
GOOGLE_REVIEWS_SYNC_INTERVAL_HOURS=12

# ── SMS provider (OPTIONAL — leave unset until creds are supplied) ──
# When unset, queued SMS jobs fail honestly with "SMS provider not configured".
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ── Firebase web app (public config — safe to commit; not secrets) ──
# Admin sign-in (email/password + Google), browser→Storage media uploads,
# and the Firestore media registry use these. The clinic's live values are
# defaulted in src/lib/firebase-config.ts; override here if the project
# ever changes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Extra Google-account allowlist for admin Firebase sign-ins (comma-separated).
# A Firebase sign-in only reaches the CMS if the email matches an AdminUser
# row OR appears here.
# ADMIN_FIREBASE_EMAILS=

# ── Firebase Storage via SERVICE ACCOUNT (OPTIONAL server-side path) ──
# The admin upload route falls back to these when the browser has no
# Firebase session (offline sign-in). Without them it uses local disk.
# FIREBASE_SERVICE_ACCOUNT_KEY={"project_id":"…","client_email":"…","private_key":"…"}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
